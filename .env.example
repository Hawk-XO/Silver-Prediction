# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real secrets. Leave any KITE_* value blank until your Zerodha app is
# verified; every module in this project treats missing Kite credentials as
# "Kite fetching disabled" rather than crashing, so the rest of the pipeline
# (MySQL storage, manual CSV ingestion, proxy fetch) all work without them.

# --- Zerodha Kite Connect (leave blank until app is verified) ---
KITE_API_KEY=
KITE_API_SECRET=
# KITE_ACCESS_TOKEN is short-lived (expires daily) — regenerated via the
# login flow in data/kite_fetcher.py, not something you hand-fill long-term.
KITE_ACCESS_TOKEN=

# Optional: data vendor keys if you use a paid MCX/COMEX data provider
DATA_VENDOR_API_KEY=

# --- MySQL ---
# MYSQL_PASSWORD below is a PLACEHOLDER -- run_eod_job.py refuses to run
# (and alerts) if this is still one of the known example values
# ("silver_pass", "pick_your_own_password", "changeme", "", etc). Set a
# real password before running the EOD job for real.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=silver_user
MYSQL_PASSWORD=silver_pass
MYSQL_DATABASE=silver_algo

# --- Default contract targeting ---
MCX_COMMODITY=SILVERMIC

# --- EOD job (run_eod_job.py / check_heartbeat.py) ---
# Optional Slack-compatible incoming webhook URL. If unset, alerts are still
# always logged at CRITICAL, just not POSTed anywhere.
ALERT_WEBHOOK_URL=

# How many calendar days behind "today" the newest data point can be before
# it's treated as stale rather than a normal weekend/holiday gap.
EOD_MAX_STALE_CALENDAR_DAYS=4

# Where run_eod_job.py writes its heartbeat JSON file after every run.
EOD_HEARTBEAT_PATH=logs/heartbeat.json

# How old (in hours) the heartbeat file can get before check_heartbeat.py's
# separate cron job alerts that the EOD job appears to have stopped running.
# Default (96h / 4 days) is generous enough to cross a weekend + 1 holiday
# without a false alarm.
EOD_HEARTBEAT_MAX_AGE_HOURS=96
