# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real secrets. Leave any KITE_* value blank until your Zerodha app is
# verified; every module in this project treats missing Kite credentials as
# "Kite fetching disabled" rather than crashing, so the rest of the pipeline
# (MySQL storage, manual CSV ingestion, proxy fetch) all work without them.

# --- Zerodha Kite Connect (leave blank until app is verified) ---
KITE_API_KEY=
KITE_API_SECRET=
# KITE_ACCESS_TOKEN is short-lived (expires daily) — regenerated via the
# login flow in data/kite_fetcher.py, not something you hand-fill long-term.
KITE_ACCESS_TOKEN=

# Optional: data vendor keys if you use a paid MCX/COMEX data provider
DATA_VENDOR_API_KEY=

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=silver_user
MYSQL_PASSWORD=silver_pass
MYSQL_DATABASE=silver_algo

# --- Default contract targeting ---
MCX_COMMODITY=SILVERMIC
